# ── Database (MongoDB via Prisma) ─────────────────────────────────────────────
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/psx_analyzer?retryWrites=true&w=majority

# ── Filters ───────────────────────────────────────────────────────────────────
SHARIAH_MODE=compliant
INDEX_FILTER=KSE-100

# ── AI Model ──────────────────────────────────────────────────────────────────
AI_MODEL=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL_TEMP=0.2
AI_MAX_TOKENS=4000

# ── Composite Score Weights (must sum to 1.0) ─────────────────────────────────
WEIGHT_TECHNICAL=0.35
WEIGHT_SENTIMENT=0.15
WEIGHT_FUNDAMENTAL=0.35
WEIGHT_MACRO=0.15

# ── Notifications ─────────────────────────────────────────────────────────────
NOTIFY_EMAIL=true
NOTIFY_WHATSAPP=false
NOTIFY_ON_ALERT_ONLY=false

# Email
EMAIL_PROVIDER=smtp
EMAIL_FROM=reports@yourdomain.com
EMAIL_TO=analyst@yourdomain.com
SENDGRID_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# WhatsApp (Green-API — https://green-api.com)
# chatId format: countrycode+number@c.us  e.g. 923001234567@c.us
WHATSAPP_CHAT_ID=WHATSAPP_CHAT_ID
GREEN_API_INSTANCE_ID=GREEN_API_INSTANCE_ID
GREEN_API_TOKEN=GREEN_API_TOKEN
GREEN_API_URL=GREEN_API_URL

# ── Alert Thresholds ──────────────────────────────────────────────────────────
ALERT_RSI_OVERSOLD=30
ALERT_RSI_OVERBOUGHT=70
ALERT_PRICE_DROP_PCT=5
CIRCUIT_BREAKER_INDEX_DROP_PCT=5

# ── PSX Terminal API ──────────────────────────────────────────────────────────
# Register at https://psxterminal.com for API access
# ── Data Source Strategy ──────────────────────────────────────────────────────
# auto        = PSX.com.pk scraper (free) → PSX Terminal API → stub (recommended)
# psx_scraper = use only PSX.com.pk scraper (no key needed, live prices)
# psxterminal = use only PSX Terminal API (requires API key below)
# stub        = deterministic mock data (for testing/CI)
DATA_SOURCE=auto

# PSX Terminal API (optional — register at https://psxterminal.com)
PSXTERMINAL_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
