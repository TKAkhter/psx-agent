# ── MongoDB ────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=psxAgent
MONGODB_DB=psx_agent

# ── Data source ────────────────────────────────────────────────
# "psx" = PSXTerminal.com real-time API (recommended)
# "yahoo" = Yahoo Finance historical (fallback)
PORTFOLIO_TYPE=psx
PSX_BASE_URL=https://psxterminal.com

# ── Email (Gmail App Password) ─────────────────────────────────
EMAIL_ENABLED=true
EMAIL_USER=you@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_TO=you@gmail.com
EMAIL_THEME=dark

# ── Green API WhatsApp ─────────────────────────────────────────
# Free: 1500 messages/month  |  https://green-api.com
#
# Setup (5 min):
# 1. Register at green-api.com → Create instance → Scan QR with WhatsApp
# 2. Copy Instance ID and Token from dashboard
# 3. WHATSAPP_CHAT_ID = phone with country code + @c.us (no + prefix)
#    e.g. 923001234567@c.us  for +92 300 1234567
WHATSAPP_ENABLED=false
WHATSAPP_INSTANCE_ID=7107597280
WHATSAPP_TOKEN=your_instance_token_here
WHATSAPP_CHAT_ID=923001234567@c.us

# ── Gemini AI ──────────────────────────────────────────────────
GEMINI_ENABLED=true
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.5-flash-preview-04-17
