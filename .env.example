# ─────────────────────────────────────────────────────────────
#  PSX Agent — Environment Configuration
#  Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Timezone used for all timestamps (Asia/Karachi = PKT)
TIMEZONE=Asia/Karachi

# Data source: "psx" uses PSXTerminal.com (live PSX data),
# "yahoo" uses Yahoo Finance (.KA tickers) as a fallback.
PORTFOLIO_TYPE=psx
PSX_BASE_URL=https://psxterminal.com

# ── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=psx_agent

# ── Email (Gmail App Password — not your real Gmail password) ──
EMAIL_ENABLED=true
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_TO=you@gmail.com
EMAIL_THEME=light

# ── WhatsApp via Green API (green-api.com) ─────────────────
# Setup (~5 min): register at green-api.com → create instance →
# scan QR with WhatsApp → copy Instance ID + Token from dashboard.
# WHATSAPP_CHAT_ID format: <countrycode><number>@c.us, e.g. 923001234567@c.us
WHATSAPP_ENABLED=true
WHATSAPP_INSTANCE_ID=your-instance-id
WHATSAPP_TOKEN=your-instance-token
WHATSAPP_CHAT_ID=923001234567@c.us
# Optional override — defaults to https://<INSTANCE_ID>.api.greenapi.com
GREEN_API_URL=https://1234567.api.greenapi.com

# ── Gemini AI ───────────────────────────────────────────────
GEMINI_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
